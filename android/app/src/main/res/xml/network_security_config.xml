<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 显式允许明文 HTTP 以兼容第三方网文书源站，避免局域与经典站访问受阻 -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
